# Required — Notion integration secret
NOTION_INTEGRATION_SECRET=secret_xxx

# Required — Primary database data source IDs (run setup_dev.py to auto-discover)
UB_TASKS_DS_ID=
UB_PROJECTS_DS_ID=
UB_NOTES_DS_ID=
UB_TAGS_DS_ID=
UB_GOALS_DS_ID=

# Optional — Workspace timezone (IANA name) used by daily_review_snapshot for
# resolving "now" / "today" / "tomorrow". Falls back to TZ, then UTC.
UB_TIMEZONE=Europe/London

# Optional — MCP transport: stdio (default) or streamable-http. For
# streamable-http, UB_HOST / UB_PORT set the bind address (defaults
# 127.0.0.1:8000).
UB_TRANSPORT=
UB_HOST=
UB_PORT=

# Optional — streamable-http Host-header allowlist (comma-separated; ":*"
# port wildcard supported, e.g. "ultimate-brain-mcp:*"). FastMCP's DNS
# rebinding protection allows only localhost Hosts by default, so a server
# behind a proxy or MCP gateway answers 421 to every request unless the
# Hosts it is reached as are listed here. UB_ALLOWED_ORIGINS is the same
# for the Origin header (browser-based clients); it requires
# UB_ALLOWED_HOSTS. Both unset -> the localhost-only default stands.
UB_ALLOWED_HOSTS=
UB_ALLOWED_ORIGINS=

# Optional — Secondary database data source IDs
UB_WORK_SESSIONS_DS_ID=
UB_MILESTONES_DS_ID=
UB_PEOPLE_DS_ID=
UB_BOOKS_DS_ID=
UB_READING_LOG_DS_ID=
UB_GENRES_DS_ID=
UB_RECIPES_DS_ID=
UB_MEAL_PLANNER_DS_ID=
